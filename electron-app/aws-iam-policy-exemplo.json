{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LigarDesligarInstancia",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:sa-east-1:SEU_ACCOUNT_ID:instance/SEU_INSTANCE_ID"
    },
    {
      "Sid": "VerStatusDeQualquerInstancia",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
