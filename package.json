{
  "name": "minecraft-server",
  "version": "1.0.0",
  "description": "Servidor Minecraft Java + Bedrock com Paper e GeyserMC",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c green,cyan \"node start-server.js\" \"node web-server.js\"",
    "dev:tunnel": "concurrently -n SERVER,WEB,TUNNEL -c green,cyan,magenta \"node start-server.js\" \"node web-server.js\" \"bash start-tunnel.sh\"",
    "start": "node start-server.js",
    "web": "node web-server.js",
    "tunnel": "bash start-tunnel.sh",
    "setup": "bash setup.sh",
    "setup-geyser": "node setup-geyser.js",
    "setup-simple": "node setup-geyser-simple.js",
    "enable-rcon": "node enable-rcon.js"
  },
  "keywords": [
    "minecraft",
    "server",
    "paper",
    "geyser"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
